  "dialect_phonology_notes": {
    "egyptian": {
      "qaf": "ʔ (glottal stop) — قلب → 'alb",
      "jeem": "g — جميل → gamil",
      "tha": "t — ثلاثة → talata",
      "dhal": "z — ذهب → zahab",
      "notes": "Cairo prestige dialect. Stress on penultimate syllable. Feminine -a endings preserved."
    },
    "levantine": {
      "qaf": "ʔ (glottal) in urban speech — قال → 'al",
      "jeem": "dʒ — جميل → jmiil",
      "tha": "t — ثلاثة → tlate",
      "notes": "Includes Syrian, Lebanese, Palestinian, Jordanian. Stress shifts. Short vowels often drop."
    },
    "gulf": {
      "qaf": "g in some regions — قال → gal",
      "jeem": "y in some regions — جميل → ymiil",
      "tha": "θ preserved — ثلاثة → θalaθa",
      "notes": "KSA, UAE, Kuwait, Bahrain. Long vowels preserved. Formal register close to MSA."
    },
    "maghrebi": {
      "qaf": "q or g — قال → qal / gal",
      "jeem": "dʒ — جميل → jmiil",
      "tha": "t — ثلاثة → tlata",
      "notes": "Morocco, Algeria, Tunisia. Heavy Berber/French loanword influence. Verb prefix كـ for present progressive. Pronoun ديالي for possession."
    }
  }
